# Greffio production secrets template
# Copy this file content into /opt/greffio/.env on the VPS.
# Do not commit real values.

NODE_ENV=production
PORT=8787

# Public URLs
APP_URL=https://greffio.willentreprises.com
API_BASE_URL=https://api.greffio.willentreprises.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Auth
JWT_SECRET=replace_with_strong_random_secret_min_64_chars

# OpenAI / Assistant Greffio
OPENAI_API_KEY=replace_with_new_production_key
OPENAI_MODEL=gpt-5.1-mini

# Emails transactionnels (Resend)
RESEND_API_KEY=
FROM_EMAIL="L'équipe Greffio <contact@willentreprises.com>"

# Supabase Storage
DOCUMENT_STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=greffio-documents

# Company lookup providers
COMPANY_LOOKUP_ENABLE_SECONDARY=false
COMPANY_LOOKUP_SECONDARY_PROVIDER=entreprise_data_gouv
COMPANY_LOOKUP_ENABLE_INSEE=false
INSEE_API_TOKEN=
COMPANY_LOOKUP_ENABLE_PAPPERS=false
PAPPERS_API_TOKEN=

# Payments (Mollie)
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=https://api.greffio.willentreprises.com/webhooks/mollie

# Optional monitoring
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
