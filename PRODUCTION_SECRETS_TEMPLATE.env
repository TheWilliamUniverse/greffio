# Greffio production secrets template
# Copy this file content into /opt/greffio/.env on the VPS.
# Do not commit real values.

NODE_ENV=production
PORT=8787

# Public URLs
APP_URL=https://greffio.willentreprises.com
API_BASE_URL=https://api.greffio.willentreprises.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Auth
JWT_SECRET=replace_with_strong_random_secret_min_64_chars

# OpenAI / Assistant Greffio
OPENAI_API_KEY=replace_with_new_production_key
OPENAI_MODEL=gpt-5.1-mini

# Emails transactionnels (Brevo – provider principal)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=contact@willentreprises.com
BREVO_SENDER_NAME=Greffio Team
BREVO_REPLY_TO=greffio@willentreprises.com
BREVO_REPLY_TO_NAME=Greffio Team
BREVO_WEBHOOK_SECRET=
# Fallback Resend (optionnel)
RESEND_API_KEY=
FROM_EMAIL="Greffio Team <contact@willentreprises.com>"
RESEND_WEBHOOK_SIGNING_SECRET=
SUPPORT_EMAIL=contact@willentreprises.com
SALES_EMAIL=contact@willentreprises.com
PASSWORD_RESET_EXPIRATION_MINUTES=30
# Page privée /telechargement-app – code envoyé à cette adresse
APP_DOWNLOAD_CODE_RECIPIENT=ibtissam@willentreprises.com
# Code admin permanent (6 chiffres ou alphanum) pour accès direct sans email
ADMIN_APP_DOWNLOAD_CODE=
EMAIL_LOGO_URL=https://api.greffio.willentreprises.com/assets/email/greffio-wordmark-white.png

# Document storage – production recommandée : AWS S3 (bucket privé)
DOCUMENT_STORAGE_DRIVER=s3
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=greffio-production-documents
AWS_S3_PRESIGNED_URL_TTL_SECONDS=900
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_WEBHOOK_SECRET=

# Fallback Supabase Storage (legacy / secours)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=greffio-documents

# Verification engine (optionnel – enrichissement Pappers)
PAPPERS_API_TOKEN=
COMPANY_LOOKUP_ENABLE_SECONDARY=false
COMPANY_LOOKUP_SECONDARY_PROVIDER=entreprise_data_gouv

# Payments (GoCardless – provider principal Greffio)
GOCARDLESS_ENV=live
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_WEBHOOK_URL=https://api.greffio.willentreprises.com/webhooks/gocardless
# Amazon Pay – retiré juin 2026 (voir docs/runbooks/AMAZON_PAY_RETRAIT_COMPLET_GREFFIO.md)

# Google Pay (B2C – capture via CAWL en aval)
GOOGLE_PAY_API_KEY=
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_NAME=Greffio
GOOGLE_PAY_ENVIRONMENT=TEST
GOOGLE_PAY_GATEWAY=cawl
GOOGLE_PAY_GATEWAY_MERCHANT_ID=

# Optional monitoring
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
