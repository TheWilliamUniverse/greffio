# Greffio production secrets template
# Copy this file content into /opt/greffio/.env on the VPS.
# Do not commit real values.

NODE_ENV=production
PORT=8787

# Public URLs
APP_URL=https://greffio.willentreprises.com
API_BASE_URL=https://api.greffio.willentreprises.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# Auth
JWT_SECRET=replace_with_strong_random_secret_min_64_chars

# OpenAI / Assistant Greffio
OPENAI_API_KEY=replace_with_new_production_key
OPENAI_MODEL=gpt-5.1-mini

# Emails transactionnels (Brevo — provider principal)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=contact@willentreprises.com
BREVO_SENDER_NAME=Greffio Team
BREVO_REPLY_TO=greffio@willentreprises.com
BREVO_REPLY_TO_NAME=Greffio Team
BREVO_WEBHOOK_SECRET=
# Fallback Resend (optionnel)
RESEND_API_KEY=
FROM_EMAIL="Greffio Team <contact@willentreprises.com>"
RESEND_WEBHOOK_SIGNING_SECRET=
SUPPORT_EMAIL=contact@willentreprises.com
SALES_EMAIL=contact@willentreprises.com
PASSWORD_RESET_EXPIRATION_MINUTES=30
EMAIL_LOGO_URL=https://api.greffio.willentreprises.com/assets/email/greffio-wordmark-white.png

# Supabase Storage
DOCUMENT_STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_STORAGE_BUCKET=greffio-documents

# Company lookup providers
COMPANY_LOOKUP_ENABLE_SECONDARY=false
COMPANY_LOOKUP_SECONDARY_PROVIDER=entreprise_data_gouv
COMPANY_LOOKUP_ENABLE_INSEE=false
INSEE_API_TOKEN=
COMPANY_LOOKUP_ENABLE_PAPPERS=false
PAPPERS_API_TOKEN=

# Payments (GoCardless — provider principal Greffio)
GOCARDLESS_ENV=live
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_WEBHOOK_URL=https://api.greffio.willentreprises.com/webhooks/gocardless
# Fallback Mollie (legacy, optionnel)
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=

# Optional monitoring
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
