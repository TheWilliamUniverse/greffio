# Snippet nginx — proxy Mollie depuis le frontend vers l'API Greffio.
# À intégrer dans le vhost HTTPS de greffio.willentreprises.com (site statique SPA).
#
# Objectif : les URLs Mollie dashboard
#   https://greffio.willentreprises.com/api/mollie/callback
#   https://greffio.willentreprises.com/api/webhooks/mollie
# atteignent l'API Node (api.greffio.willentreprises.com) au lieu du SPA.
#
# Tester après reload :
#   curl -sI https://greffio.willentreprises.com/api/mollie/status
#   curl -sI -X POST https://greffio.willentreprises.com/api/webhooks/mollie

location /api/mollie/ {
    proxy_pass https://api.greffio.willentreprises.com/api/mollie/;
    proxy_set_header Host api.greffio.willentreprises.com;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

location = /api/webhooks/mollie {
    proxy_pass https://api.greffio.willentreprises.com/api/webhooks/mollie;
    proxy_set_header Host api.greffio.willentreprises.com;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}
