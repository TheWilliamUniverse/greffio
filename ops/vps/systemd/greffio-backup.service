[Unit]
Description=Sauvegarde chiffree Greffio PostgreSQL et stockage objet
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/greffio
ExecStart=/usr/bin/env bash /opt/greffio/ops/vps/scripts/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
