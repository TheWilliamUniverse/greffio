# Extrait des variables cible relatives a la migration.
# Fusionner avec les autres secrets applicatifs dans /opt/greffio/.env.vps-target.

NODE_ENV=production
PORT=8787
# Ne pas ajouter sslmode dans DATABASE_URL : le client Node utilise DATABASE_SSL.
DATABASE_URL=postgresql://greffio_app:CHANGE_ME@127.0.0.1:5433/greffio
DATABASE_SSL=require

DOCUMENT_STORAGE_DRIVER=s3
S3_ENDPOINT=https://storage.greffio.willentreprises.com
S3_REGION=garage
S3_ACCESS_KEY_ID=GK_CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=greffio-production-documents
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=900
# Garage n'active pas un KMS par defaut. Laisser vide tant qu'un chiffrement serveur n'est pas configure.
S3_SERVER_SIDE_ENCRYPTION=

# Aucune variable SUPABASE_* ne doit subsister dans le fichier cible.
