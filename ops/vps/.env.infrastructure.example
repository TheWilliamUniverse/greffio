# Copier vers ops/vps/.env.infrastructure sur le VPS puis chmod 600.
# Ne jamais committer la copie renseignee.

POSTGRES_ADMIN_USER=greffio_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
GREFFIO_DB_NAME=greffio
GREFFIO_DB_USER=greffio_app
GREFFIO_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD

# Valeurs hexadecimales recommandees pour eviter les problemes de rendu TOML.
GARAGE_RPC_SECRET=CHANGE_ME_64_HEX_CHARACTERS
GARAGE_ADMIN_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
GARAGE_METRICS_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
GARAGE_DEFAULT_ACCESS_KEY=GK_CHANGE_ME
GARAGE_DEFAULT_SECRET_KEY=CHANGE_ME_64_HEX_CHARACTERS
GARAGE_DEFAULT_BUCKET=greffio-production-documents

# Sauvegarde chiffree hors VPS. Exemple : sftp:user@backup-host:/greffio
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=5
RESTIC_KEEP_MONTHLY=12
