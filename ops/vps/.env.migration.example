# Copier vers ops/vps/.env.migration sur le VPS puis chmod 600.
# Identifiants temporaires : les revoquer apres validation de la migration.

# Base source Supabase. Utiliser le Session Pooler si la connexion directe IPv6 echoue.
SOURCE_DATABASE_URL=postgresql://SOURCE_USER:SOURCE_PASSWORD@SOURCE_HOST:5432/postgres?sslmode=require

# Base cible PostgreSQL locale, avec le compte applicatif cree par compose.yml.
# Ne pas ajouter sslmode ici : les scripts Node appliquent DATABASE_SSL=require
# avec le certificat local, tandis que les outils libpq recoivent PGSSLMODE=require.
TARGET_DATABASE_URL=postgresql://greffio_app:TARGET_PASSWORD@127.0.0.1:5433/greffio
DATABASE_SSL=require

# Acces temporaire a Supabase Storage pour migrer d'eventuels objets supabase://.
MIGRATION_SUPABASE_URL=https://PROJECT_REF.supabase.co
MIGRATION_SUPABASE_SERVICE_ROLE_KEY=TEMPORARY_ROTATED_KEY

# Fichier .env final du backend, prepare manuellement et chmod 600.
TARGET_APP_ENV_FILE=/opt/greffio/.env.vps-target
