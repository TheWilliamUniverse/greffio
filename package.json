    "test:mfa-email-code": "node --test server/mfaEmailCodeStore.test.js",
    "test:app-update": "node --test src/services/appUpdate/tests/appUpdateLogic.test.js",
    "test:comparator": "node --test src/utils/legalFormComparatorEngine.test.js",
