VITE_API_BASE_URL=
VITE_APP_URL=
# Délai minimum (jours) avant relance email dossier inactif (défaut : 2)
DOSSIER_REMINDER_MIN_DAYS=2
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=greffio-documents
DOCUMENT_STORAGE_DRIVER=s3
# local | supabase | s3 — prod Greffio : s3 (AWS). Supabase Storage = optionnel, non utilisé en prod actuelle.
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=greffio-production-documents
AWS_S3_PRESIGNED_URL_TTL_SECONDS=900
DIDIT_API_KEY=
# UUID from GET https://verification.didit.me/v3/workflows/ (not the Application id)
DIDIT_WORKFLOW_ID=
DIDIT_APP_ID=
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_WEBHOOK_SECRET=
SIGNATURIT_ACCESS_TOKEN=
SIGNATURIT_API_BASE_URL=
# SignWell — signature électronique (https://www.signwell.com)
SIGNATURE_PROVIDER=internal
SIGNWELL_API_KEY=
SIGNWELL_API_APPLICATION_ID=
SIGNWELL_WEBHOOK_ID=
SIGNWELL_CALLBACK_URL=https://api.greffio.willentreprises.com/callback
SIGNWELL_API_BASE_URL=https://www.signwell.com/api/v1
SIGNWELL_TEST_MODE=false
API_PUBLIC_URL=https://api.greffio.willentreprises.com
APP_URL=https://greffio.willentreprises.com
PAPPERS_API_TOKEN=
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=

# Clé dédiée au chiffrement des secrets TOTP (64+ caractères en production)
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Google Pay (B2C — règlement final via CAWL en aval)
GOOGLE_PAY_API_KEY=
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_NAME=Greffio
GOOGLE_PAY_ENVIRONMENT=TEST
GOOGLE_PAY_GATEWAY=cawl
GOOGLE_PAY_GATEWAY_MERCHANT_ID=
VITE_GOOGLE_PAY_ENABLED=true
VITE_GOOGLE_PAY_MERCHANT_ID=
VITE_GOOGLE_PAY_ENVIRONMENT=TEST
VITE_GOOGLE_PAY_MERCHANT_NAME=Greffio

GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_WEBHOOK_URL=
GOCARDLESS_ENV=live

# ===== Architecture paiement multi-prestataires =====
# CAWL — PSP B2C (carte / wallet / e-commerce).
# Voir docs/PAYMENTS_ARCHITECTURE.md
CAWL_API_BASE_URL=
CAWL_API_KEY=
CAWL_API_KEY_ID=
CAWL_MERCHANT_ID=
CAWL_WEBHOOK_SECRET=
CAWL_RETURN_URL=
CAWL_CANCEL_URL=

# Qonto — rapprochement bancaire (jamais PSP B2C).
QONTO_CLIENT_ID=
QONTO_CLIENT_SECRET=
QONTO_ORGANIZATION_ID=

# Virement manuel — coordonnées affichées en B2B sans GoCardless.
WILLIAM_ESTABLISHMENTS_IBAN=
WILLIAM_ESTABLISHMENTS_BIC=
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Greffio Team
BREVO_REPLY_TO=greffio@willentreprises.com
BREVO_REPLY_TO_NAME=Greffio Team
BREVO_WEBHOOK_SECRET=
RESEND_API_KEY=
FROM_EMAIL=
PASSWORD_RESET_EXPIRATION_MINUTES=30
FCM_SERVICE_ACCOUNT_JSON=
# JSON compte de service Firebase pour envoi push Android (backend VPS)
SALES_EMAIL=contact@willentreprises.com
RESEND_WEBHOOK_SIGNING_SECRET=
EMAIL_LOGO_URL=https://api.greffio.willentreprises.com/assets/email/greffio-wordmark-white.png
COMPANY_LOOKUP_TIMEOUT_MS=6500
COMPANY_LOOKUP_CACHE_TTL_MS=300000
COMPANY_LOOKUP_ENABLE_SECONDARY=false
COMPANY_LOOKUP_SECONDARY_PROVIDER=entreprise_data_gouv
COMPANY_LOOKUP_ENABLE_INSEE=false
INSEE_API_BASE_URL=https://api.insee.fr/entreprises/sirene/V3.11
INSEE_API_TOKEN=
COMPANY_LOOKUP_ENABLE_PAPPERS=false
PAPPERS_API_BASE_URL=https://api.pappers.fr/v2
PAPPERS_API_TOKEN=

# ===== Sécurité anti-abus (Lot P0) =====
# Cloudflare Turnstile — désactivé par défaut ; activer après création des clés
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENFORCE_LOGIN=false
TURNSTILE_ENFORCE_SIGNUP=false
TURNSTILE_ENFORCE_CONTACT=false
TURNSTILE_ENFORCE_FORGOT_PASSWORD=false
TURNSTILE_ENFORCE_RESET_PASSWORD=false
TURNSTILE_RISKY_LOGIN=true
TURNSTILE_LOGIN_RISKY_THRESHOLD=2
TURNSTILE_FAIL_OPEN=false
# reCAPTCHA Google — fallback uniquement si Turnstile indisponible ou plafond atteint
RECAPTCHA_FALLBACK_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Plafonds anti-coût (vérifications externes + assistant IA)
CAPTCHA_VERIFY_HOURLY_MAX=400
CAPTCHA_VERIFY_DAILY_MAX=3000
TURNSTILE_VERIFY_HOURLY_MAX=350
RECAPTCHA_VERIFY_HOURLY_MAX=120
ASSISTANT_HOURLY_MAX=80
ASSISTANT_DAILY_MAX=400
TURNSTILE_DEGRADE_MINUTES=30
# Rate limits globaux Express (prod : 300 req/min/IP sur /api/*)
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=300
STRICT_PUBLIC_RATE_LIMIT_MAX=40
HEALTH_RATE_LIMIT_MAX=60
# CSP progressive (report-only d'abord)
CSP_REPORT_ONLY=true
SECURITY_STORE=postgres
CSP_REPORT_URI=
# Observabilité (optionnel)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SECURITY_ALERT_WEBHOOK_URL=
# Frontend Turnstile (Vite — rebuild requis après changement)
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ON_CONTACT=true
VITE_TURNSTILE_ON_SIGNUP=true
VITE_TURNSTILE_ON_LOGIN_RISKY=true
VITE_TURNSTILE_ON_PASSWORD_RESET=true
