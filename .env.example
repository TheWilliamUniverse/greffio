SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=greffio-documents
DOCUMENT_STORAGE_DRIVER=s3
# local | supabase | s3 – prod Greffio : s3 (AWS). Supabase Storage = optionnel, non utilisé en prod actuelle.
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=greffio-production-documents
AWS_S3_PRESIGNED_URL_TTL_SECONDS=900
DIDIT_API_KEY=
# UUID from GET https://verification.didit.me/v3/workflows/ (not the Application id)
DIDIT_WORKFLOW_ID=
DIDIT_APP_ID=
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_WEBHOOK_SECRET=
SIGNATURIT_ACCESS_TOKEN=
SIGNATURIT_API_BASE_URL=
# Signature documentaire Greffio (greffio_internal uniquement)
SIGNATURE_PROVIDER=internal
GREFFIO_SIGNATURE_PROVIDER=greffio_internal
GREFFIO_SIGNATURE_DEFAULT_LEVEL=ses_reinforced
GREFFIO_SIGNATURE_REQUIRE_OTP=false
GREFFIO_SIGNATURE_TOKEN_TTL_HOURS=72
GREFFIO_SIGNATURE_MAX_ATTEMPTS=8
# URL API publique (ONLYOFFICE, webhooks, emails) — alias accepté : GREFFIO_API_URL
GREFFIO_API_URL=https://api.greffio.willentreprises.com
# Hostinger API (scripts deploy / health — jamais côté frontend)
HOSTINGER_API_TOKEN=
HOSTINGER_API_BASE_URL=https://developers.hostinger.com
HOSTINGER_DEPLOY_DOMAIN=clareffio.willentreprises.com
HOSTINGER_VERIFY_URL=https://clareffio.willentreprises.com/health
API_PUBLIC_URL=https://api.greffio.willentreprises.com
APP_URL=https://clareffio.willentreprises.com
GREFFIO_APP_URL=https://clareffio.willentreprises.com
PAPPERS_API_TOKEN=
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=

# Clé dédiée au chiffrement des secrets TOTP (64+ caractères en production)
MFA_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

