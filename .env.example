# ===== Architecture paiement multi-prestataires =====
# Mollie – PSP principal (B2C carte, B2B, factures)
MOLLIE_API_KEY=
MOLLIE_PROFILE_ID=
# App OAuth dashboard « Greffio » (paiement B2C — callback frontend, pas le flux Connect)
MOLLIE_PAYMENT_OAUTH_CLIENT_ID=
MOLLIE_PAYMENT_OAUTH_CLIENT_SECRET=
# App OAuth dashboard « Greffio Connect for Partners » (onboarding pros — vars dédiées)
MOLLIE_OAUTH_CLIENT_ID=
MOLLIE_OAUTH_CLIENT_SECRET=
MOLLIE_CONNECT_REDIRECT_URI=https://api.greffio.willentreprises.com/api/mollie/connect/callback
# MOLLIE_CONNECT_SCOPES=payments.read payments.write profiles.read profiles.write onboarding.read organizations.read
# Redirect utilisateur après checkout (dashboard Mollie) – proxy PHP sur le frontend :
MOLLIE_CALLBACK_URL=https://clareffio.willentreprises.com/api/mollie/callback
# Webhook serveur-à-serveur (toujours sur le domaine API) :
MOLLIE_WEBHOOK_URL=https://api.greffio.willentreprises.com/api/webhooks/mollie

# ONLYOFFICE Document Server (édition DOCX)
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=

# Qonto – rapprochement bancaire + factures client (jamais PSP B2C).
# Identifiant Qonto (tableau de bord) → QONTO_CLIENT_ID ou alias QONTO_LOGIN
QONTO_CLIENT_ID=
QONTO_CLIENT_SECRET=
# Alias acceptés par le code : QONTO_LOGIN, QONTO_SECRET_KEY
QONTO_ORGANIZATION_ID=
QONTO_API_BASE_URL=https://thirdparty.qonto.com/v2

# ===== Emails transactionnels (défauts audit 2026-06-13) =====
EMAIL_LOGIN_ALERTS_ENABLED=false
EMAIL_DOSSIER_CONTACT_CONFIRMED_ENABLED=false
EMAIL_DOCUMENT_UPLOAD_RECEIVED_ENABLED=true
EMAIL_DOSSIER_REMINDERS_ENABLED=true
EMAIL_RESOURCE_ORDER_INTERNAL_ENABLED=false
EMAIL_DOSSIER_CREATED_ENABLED=true
EMAIL_STATUTES_GENERATED_ENABLED=true
EMAIL_INVOICE_PAYMENT_ENABLED=true
EMAIL_WEEKLY_DIGEST_ENABLED=false
EMAIL_SATISFACTION_REQUEST_ENABLED=true
EMAIL_SATISFACTION_INTERVAL_DAYS=9
EMAIL_OPS_NOTIFICATIONS_ENABLED=true
EMAIL_SIGNATURE_REQUESTS_ENABLED=true

# Factures auto après paiement dossier + validation ops avant envoi client
INVOICE_AUTO_GENERATE_ON_PAYMENT=true
INVOICE_REQUIRE_OPS_REVIEW_BEFORE_SEND=true
OPS_INVOICE_REVIEW_EMAIL=contact@willentreprises.com

# Mistral OCR (exploration – stub P2)
MISTRAL_API_KEY=
MISTRAL_OCR_ENABLED=false
MISTRAL_OCR_MODEL=mistral-ocr-latest

